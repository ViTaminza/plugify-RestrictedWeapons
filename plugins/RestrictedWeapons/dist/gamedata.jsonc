{
  // RestrictedWeapons gamedata - s2sdk gamedata format (same schema as the s2sdk plugin's own
  // gamedata.jsonc), loaded via s2sdk LoadGameConfigFile / GetGameConfigSignature.
  //
  // CCSPlayer_ItemServices::CanAcquire is hooked with the polyhook plugin (the Pisex utils plugin
  // owned this hook via funchook; the port does it itself). The pattern is the "CanAcquire" entry
  // of the production server's addons/configs/signatures.ini, whose comment says
  // "Search: CCSPlayer_ItemServices::CanAcquire".
  //
  // Verified against the current game binary /srv/cs2-go/game/csgo/bin/linuxsteamrt64/libserver.so
  // (via the byte-for-byte dump .analysis-scratch/libserver_live.hex, 41,749,016 bytes - the same
  // size as cs2test/upper/game/csgo/bin/linuxsteamrt64/libserver.so and identical byte sequences
  // around .text start and at this signature): exactly ONE match of this pattern in the file, at
  // file offset 0x159DD00 = VA 0x159ED00 (.text starts at file offset 0x9FEDC0 = VA 0x9FFDC0).
  // Disassembly of the match:
  //   push rbp; mov rbp,rsp; push r15; push r14; mov r14,rsi (pItemView);
  //   push r13; push r12; mov r12,rcx (pLimit); push rbx; mov rbx,rdi (this);
  //   sub rsp,0x78; mov r13,[rdi+0x38] (GetPawn(), null-checked) ...
  // which is exactly the prologue the Pisex utils hook wrapped:
  //   AcquireResult::Type CanAcquire(CPlayer_ItemServices* this, CEconItemView* pItemView,
  //                                  AcquireMethod::Type eMethod, uint* pLimit)
  //
  // Only the linuxsteamrt64 pattern exists (the production signatures.ini has no win64 one and the
  // target is Linux).
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify-plugin-s2sdk/refs/heads/main/schemas/gamedata.schema.json",
  "csgo": {
    "Signatures": {
      "CCSPlayer_ItemServices_CanAcquire": {
        "library": "server",
        "linuxsteamrt64": "55 48 89 E5 41 57 41 56 49 89 F6 41 55 41 54 49 89 CC 53 48 89 FB 48 83 EC ? 4C 8B 6F 38"
      }
    }
  }
}
